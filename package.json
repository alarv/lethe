{
  "name": "@alarv/lethe",
  "version": "0.0.2",
  "description": "A memory harness for coding agents that forgets on purpose.",
  "keywords": [
    "memory",
    "agent",
    "mcp",
    "llm",
    "consolidation",
    "rag"
  ],
  "license": "Apache-2.0",
  "author": "alarv <alarvfm@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alarv/lethe.git"
  },
  "homepage": "https://github.com/alarv/lethe#readme",
  "bugs": {
    "url": "https://github.com/alarv/lethe/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/testing.*",
    "docs/api-design.md",
    "docs/architecture.md",
    "docs/brain.md",
    "docs/compact.md",
    "docs/evals.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "assets": "sh scripts/assets.sh",
    "eval": "node --experimental-strip-types evals/run.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "bin": {
    "lethe": "./dist/cli.js"
  }
}
